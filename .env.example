# === Telegram User Account (Telethon) ===
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=0
TG_API_HASH=""
TG_PHONE=""
TG_SESSION_NAME="work_account"

# === MTProto Proxy (для обхода блокировки Telegram в России) ===
# Пример: TG_MTPROTO_ENABLED=true, TG_MTPROTO_HOST=83.166.234.125, TG_MTPROTO_PORT=8444
# Секрет — hex строка (16 байт), иногда с префиксом dd/ee
# Если используете SOCKS5 прокси ниже — отключите MTProto (TG_MTPROTO_ENABLED=false)
TG_MTPROTO_ENABLED=false
TG_MTPROTO_HOST=""
TG_MTPROTO_PORT=0
TG_MTPROTO_SECRET=""

# === SOCKS5/HTTP Proxy for Telethon (user client) ===
# Telethon поддерживает SOCKS5 и HTTP прокси для обхода блокировки Telegram.
# TG_PROXY_TYPE: socks5 или http
# Если пусто — Telethon использует MTProto (если настроен) или прямое подключение.
TG_PROXY_TYPE=""
TG_PROXY_HOST=""
TG_PROXY_PORT=0
TG_PROXY_USERNAME=""
TG_PROXY_PASSWORD=""

# === HTTP/SOCKS Proxy for Bot API (aiogram) ===
# MTProto прокси НЕ работает с Bot API. Нужен HTTP или SOCKS5 прокси.
# Примеры: socks5://user:pass@host:1080 или http://host:8080
# Если пусто - прямое подключение (может не работать в России)
TG_BOT_PROXY=""

# === Notification Bot (aiogram) ===
# Создать бота через @BotFather, получить токен
NOTIF_BOT_TOKEN=""
# Ваш Telegram ID (узнать через @userinfobot)
OWNER_TG_ID=0

# === AI Providers ===
# OmniRoute — БЕСПЛАТНО, агрегатор 50+ бесплатных провайдеров (Claude, GPT, Gemini)
# Установка: npm install -g omniroute, затем запустите: omniroute
# Это даст доступ к Claude Sonnet 4.5, GPT-4o и др. бесплатно с auto-fallback
# Документация: https://github.com/diegosouzapw/OmniRoute
OMNIROUTE_API_KEY="omni"
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
# Groq — БЕСПЛАТНО, 14400 запросов/день, без кредитки (запасной вариант)
# Регистрация: https://console.groq.com
GROQ_API_KEY=""
# OpenRouter — бесплатные модели (запасной вариант)
# Регистрация: https://openrouter.ai
OPENROUTER_API_KEY=""
# OpenAI (платно, опционально)
OPENAI_API_KEY=""
# DeepSeek (платно, опционально)
DEEPSEEK_API_KEY=""
# Anthropic Claude (платно, для гарантированного качества Claude Sonnet 4.5)
# Регистрация: https://console.anthropic.com
ANTHROPIC_API_KEY=""
# GigaChat (Sber AI) — БЕСПЛАТНО для резидентов РФ
# Регистрация: developers.sber.ru/portal/products/gigachat
# API ключ — base64-кодированная строка client_id:client_secret
# Модели: GigaChat, GigaChat-Pro, GigaChat-Max
GIGACHAT_API_KEY=""
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
# Запасные модели при исчерпании лимитов основной (через запятую)
# Пример: "GigaChat-Max,GigaChat-2-Pro"
GIGACHAT_FALLBACK_MODEL="GigaChat-Max"

# === AI Settings ===
# Провайдеры: gigachat, omniroute, groq, openrouter, openai, deepseek, anthropic
# GigaChat: GigaChat-2 (Lite), GigaChat-Pro, GigaChat-Max
# OmniRoute с Kiro: kr/claude-sonnet-4.5 (Claude Sonnet 4.5 через Kiro с прокси)
DIALOG_AI_PROVIDER=gigachat
DIALOG_MODEL=GigaChat-Pro
CLASSIFY_AI_PROVIDER=gigachat
CLASSIFY_MODEL=GigaChat-2
# Модель для AI-рассылки по чатам (по умолчанию как DIALOG_*)
#BROADCAST_AI_PROVIDER="gigachat"
#BROADCAST_MODEL="GigaChat-Pro"

# === Forum Outreach ===
# Имя персоны-организатора в диалогах — должно совпадать с именем профиля
# Telegram-аккаунта. Для аккаунта #2 и далее задаётся в accN.env.
BOT_PERSONA_NAME="Елена"

# === Cold Leads & 2GIS Outreach ===
# Включить поиск холодных лидов в чатах (нет прямого запроса, но есть сигналы)
COLD_LEAD_ENABLED="true"
# Лимиты холодного обхода НА АККАУНТ (type в cold_outreach_log = TG_SESSION_NAME)
COLD_OUTREACH_DAILY_LIMIT=6
COLD_OUTREACH_HOURLY_LIMIT=1
# Шардирование целей между серверами: server1=0, server2=1 (-1=выкл)
OUTREACH_SERVER_SLOT=-1
OUTREACH_SERVER_COUNT=2
# Путь к CSV из парсера 2GIS (колонки: name, phone, address, category, city)
GIS_IMPORT_PATH="data/gis_companies.csv"
GIS_CSV_ENCODING="utf-8-sig"
GIS_CSV_DELIMITER=";"

# === Anti-Ban Settings ===
# Минимальная/максимальная задержка между действиями (секунды)
ANTI_BAN_MIN_DELAY=30
ANTI_BAN_MAX_DELAY=300
# Лимит сообщений в час
ANTI_BAN_HOURLY_LIMIT=10
# Лимит сообщений в день (горячие диалоги + запланированные)
ANTI_BAN_DAILY_LIMIT=37
# Дней "прогрева" аккаунта (только чтение, без отправки). У вас аккаунт уже прогрет — 0.
WARMUP_DAYS=0
# Максимальный возраст сообщения для обработки (дни)
MAX_MESSAGE_AGE_DAYS=30

# === Database ===
DB_PATH="data/bot.db"

# === Scheduler ===
# Часовой пояс рассылки (например Asia/Novosibirsk)
SCHEDULER_TIMEZONE="Asia/Novosibirsk"

# === Server Sync (для GUI) ===
# URL сервера для синхронизации чатов (если используете локальный GUI с сервером)
# Пример: SERVER_URL="http://82.202.170.14:8080"
# Если пусто - GUI работает с локальной базой данных
SERVER_URL=""
# Токен авторизации HTTP API. Должен совпадать на сервере и в .env рядом с GUI/exe.
API_TOKEN=""

# === Developer ===
# Пол разработчика для AI-текстов: male или female (можно менять в GUI)
DEVELOPER_GENDER="male"
