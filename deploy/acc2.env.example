# Env для lead-hunter-acc2.service — скопировать на сервер как
# /opt/lead-hunter/acc2.env (chmod 600). Секреты НЕ коммитить в репо.

# Имя файла Telethon-сессии аккаунта #2 (файл лежит рядом с кодом)
TG_SESSION_NAME=session_acc2

# Прокси аккаунта #2 (HTTP/SOCKS5). Заполнить своими данными.
TG_PROXY_TYPE=http
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# Свой прокси имеет приоритет — MTProto отключаем, чтобы не было конфликта
TG_MTPROTO_ENABLED=false

# Имя персоны в диалогах — должно совпадать с именем профиля ЭТОГО аккаунта
BOT_PERSONA_NAME=Марина
